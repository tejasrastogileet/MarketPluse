# Copy this file to .env and fill in your own values.
# For local development, POSTGRES_HOST=localhost works with the docker-compose Postgres.
# For the live public deployment, point these at your free Neon/Supabase Postgres instance.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market_data
POSTGRES_USER=market_user
POSTGRES_PASSWORD=market_pass

# Free, no-signup-required key-less access works for yfinance.
# FRED requires a free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Comma-separated list of tickers to track
TICKERS=AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA,JPM,GS,V,MA,WMT,COST,XOM,CVX,UNH,JNJ,PFE,BA,DIS
